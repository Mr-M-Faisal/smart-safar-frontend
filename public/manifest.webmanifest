{
  "id": "/",
  "name": "Smart Safar",
  "short_name": "Smart Safar",
  "description": "Explore Faisalabad transit routes, bus updates, and your journey.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "shortcuts": [
    { "name": "Live map", "short_name": "Map", "url": "/live-map?source=pwa", "icons": [{ "src": "/icons/smart-safar-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Routes", "short_name": "Routes", "url": "/routes?source=pwa", "icons": [{ "src": "/icons/smart-safar-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My trips", "short_name": "Trips", "url": "/passenger?tab=history&source=pwa", "icons": [{ "src": "/icons/smart-safar-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/screenshots/smart-safar-app-narrow.png", "sizes": "1082x2202", "type": "image/png", "form_factor": "narrow", "label": "Smart Safar mobile app" },
    { "src": "/screenshots/smart-safar-app-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Smart Safar app preview" }
  ],
  "orientation": "portrait",
  "lang": "en",
  "background_color": "#111d3d",
  "theme_color": "#111d3d",
  "categories": ["travel", "navigation"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/smart-safar-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/smart-safar-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/smart-safar-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
